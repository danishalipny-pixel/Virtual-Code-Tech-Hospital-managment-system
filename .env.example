# ==============================================================================
# Virtual Code Tech - Hospital Management System (MedAxis HMS)
# Environment Configuration Template
# ==============================================================================
# This project is a client-side architecture utilizing Zustand with localStorage
# persistence and local JSON mock datasets. No external backend or database API
# keys are required for core execution.
#
# Optional future integrations or deployment variables can be configured below:

# Application Port (Defaults to 3000, or 3001 if port 3000 is occupied)
PORT=3001

# Public Application URL (Used for metadata and deployment canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Application Environment Mode
NODE_ENV=development
